{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Margem",
  "version": "0.1.0",
  "identifier": "br.com.gerlan.pdfchat",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Margem",
        "width": 1420,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "backgroundColor": "#FBFAF7"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
